# PostgreSQL database (docker-compose.yml starts one for you).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/mangalli_pos
DB_POOL_MAX=10
# Outlet created by `pnpm db:seed`, and the owner who signs in to the dashboard.
MENU_POS_DEFAULT_OUTLET_KEY=demo
POS_OWNER_EMAIL=owner@mangalli.local
POS_OWNER_PASSWORD=
# Long random string (openssl rand -base64 48). Signs dashboard sessions.
POS_SESSION_SECRET=
# Token for registering tablets through the device API (optional).
ANDROID_POS_SETUP_TOKEN=
ANDROID_POS_CUSTOM_AMOUNT_MAX=10000000
# Public address of this dashboard, used in email links.
MANGALLI_PUBLIC_URL=
# Token for a digital menu service that reads the menu and sends orders (optional).
MENU_POS_ADAPTER_TOKEN=

# Optional services. Leave empty to turn the feature off.
# Ask Eline and menu import: any OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama…).
MANGALLI_ROUTER_URL=
MANGALLI_ROUTER_KEY=
MANGALLI_ROUTER_MODEL=
# Online payments: Midtrans server key per outlet, JSON {"demo":"SB-Mid-server-..."}.
MIDTRANS_SERVER_KEYS_JSON=
MIDTRANS_IS_PRODUCTION=false
# Photo uploads to S3-compatible storage (Cloudflare R2, MinIO, S3). Empty = image links only.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
# Daily report email (SMTP over TLS, port 465). false turns the scheduler off.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
DAILY_REPORT_ENABLED=

# 1garis Studio hosting only: sign-in through the central identity proxy.
IDENTITY_PROXY_ENABLED=false
IDENTITY_PROXY_SECRET=
